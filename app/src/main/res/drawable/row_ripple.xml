<?xml version="1.0" encoding="utf-8"?>
<!-- Press highlight for rows: a rounded, inset pill instead of a square flash. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/press_ripple">
    <item android:id="@android:id/mask">
        <inset android:insetLeft="6dp" android:insetTop="3dp" android:insetRight="6dp" android:insetBottom="3dp">
            <shape android:shape="rectangle">
                <corners android:radius="14dp" />
                <solid android:color="#FFFFFFFF" />
            </shape>
        </inset>
    </item>
</ripple>
