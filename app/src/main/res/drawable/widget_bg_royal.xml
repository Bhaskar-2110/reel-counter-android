<?xml version="1.0" encoding="utf-8"?>
<!-- Widget background, Royal: violet with a gold glow in the top corner. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="24dp" />
            <gradient android:angle="300" android:startColor="#FF3A0E6B" android:centerColor="#FF5A1A93" android:endColor="#FF1E0A38" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="24dp" />
            <gradient android:type="radial" android:centerX="1" android:centerY="0" android:gradientRadius="90%p" android:startColor="#66FFCB45" android:endColor="#00FFCB45" />
            <stroke android:width="1dp" android:color="#4DFFCB45" />
        </shape>
    </item>
</layer-list>
