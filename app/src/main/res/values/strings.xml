    <string name="app_name">Reel Counter</string>

    <string name="service_label">Reel Counter</string>
    <string name="service_description">Counts the short videos you swipe through in Instagram Reels, YouTube Shorts, Snapchat Spotlight, TikTok, Moj and Josh, shows a counter while you watch, and takes you out of them when you reach your daily limit. It looks only at which screen is open, reads no text or messages, and keeps the count on this phone.</string>

    <string name="status_on">Counting is on</string>
    <string name="status_on_detail">Reels, Shorts and Spotlight from every app go into one count. A counter shows on screen while you watch.</string>
    <string name="status_off">Counting is off</string>
    <string name="status_off_detail">Open Accessibility settings, tap Reel Counter under Downloaded apps, and turn it on. If the switch is greyed out, open App info for Reel Counter, tap the ⋮ menu and choose Allow restricted settings first.</string>
    <string name="enable_button">Open Accessibility settings</string>

