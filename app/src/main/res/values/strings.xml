    <string name="onb_access_guide_title">A small video guide comes with you.</string>
    <string name="onb_access_guide_text">It floats over Settings and shows each tap, then brings you back here when you\'re done.</string>
    <string name="onb_access_full_link">Android will say \"full control\". What does that mean?</string>
    <string name="onb_access_grey_link">Can\'t turn it on? (switch greyed out)</string>
