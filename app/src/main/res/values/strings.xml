    <string name="onb_access_title">Turn on reel counting</string>
    <string name="onb_access_text">Rokoreels uses Android\'s Accessibility service to count your reels and time, and to close apps when it\'s time to stop. Here\'s everything it does with it.</string>
    <string name="onb_access_yes1">Sees which app is open and for how long, when a new reel starts, and labels like \"Sponsored\" so ads don\'t count</string>
    <string name="onb_access_yes2">Shows Iris over the apps you picked</string>
    <string name="onb_access_no1">Never reads your messages, passwords or what\'s in the videos</string>
    <string name="onb_access_yes3">Closes Reels, or the whole app, when you reach a limit or focus hours</string>
    <string name="onb_access_yes3_sub">By pressing Back or Home for you, also for Block Reels, app timers and your daily time limit</string>
    <!-- Onboarding 4/6 (design/reel-counting-permission.html) -->
    <string name="onb_access_private">What\'s on your screen never leaves your phone.</string>
    <string name="onb_access_taps">3 taps in Settings</string>
