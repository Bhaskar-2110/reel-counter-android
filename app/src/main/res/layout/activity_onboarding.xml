<?xml version="1.0" encoding="utf-8"?>
<!-- First open (design/Rokoreels App Flow.html, Onboarding): a back button, a six-step bar and
     "n/6" on top, one job per screen in the middle, and the action at the bottom. -->
<!-- fitsSystemWindows replaces a view's own padding, so it sits on the outer frame and the
     screen's margins on the inner layout (on the phone, margins were lost otherwise). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="22dp"
    android:paddingTop="6dp"
    android:paddingBottom="22dp">

    <LinearLayout
        android:id="@+id/obTop"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/obBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_button_bg"
            android:contentDescription="@string/back"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:stateListAnimator="@animator/press_scale">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_back"
                app:tint="?attr/rrText2" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/progress"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginHorizontal="10dp"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/stepText"
            style="@style/Rr.Text.Muted"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="end" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp" />
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/ghost"
        style="@style/Widget.Rr.Button.Ghost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
</FrameLayout>
