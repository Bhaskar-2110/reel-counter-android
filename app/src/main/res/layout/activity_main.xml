<?xml version="1.0" encoding="utf-8"?>
<!-- Home and Progress (design/Rokoreels App Flow.html). Home is one screen with no scrolling:
     the top bar, Iris in the ring, two numbers, one sentence and up to three apps. Progress
     scrolls. The bottom bar has just the two tabs. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/pages"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ───────────────────────── Home ───────────────────────── -->
        <LinearLayout
            android:id="@+id/pageHome"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <FrameLayout
                    android:id="@+id/settingsButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/circle_button_bg"
                    android:contentDescription="@string/settings"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:stateListAnimator="@animator/press_scale">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_gear"
                        app:tint="?attr/rrText2" />

                    <View
                        android:id="@+id/attentionDot"
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/avatar_dot"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/focusPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/focus_pill_bg"
                    android:drawablePadding="6dp"
                    android:fontVariationSettings="'wght' 600"
                    android:maxLines="1"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:stateListAnimator="@animator/press_scale"
                    android:textColor="?attr/rrText"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/wordmark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bricolage_grotesque"
                    android:fontVariationSettings="'wght' 800"
                    android:letterSpacing="-0.02"
                    android:textColor="?attr/rrText"
                    android:textSize="22sp" />
            </LinearLayout>

            <!-- Iris and the ring: the biggest thing, centred; shrinks on short screens. -->
            <com.reelcounter.SquareFrame
                android:id="@+id/hero"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="150dp">

                <com.reelcounter.RingView
                    android:id="@+id/ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <com.reelcounter.EyesView
                    android:id="@+id/mainEyes"
                    android:tag="inner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/iris_description" />
            </com.reelcounter.SquareFrame>

            <LinearLayout
                android:id="@+id/stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/todayCount"
                        style="@style/Rr.Text.Hero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        style="@style/Rr.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/reels_today_label"
                        android:textColor="?attr/rrText2"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="40dp"
                    android:background="?attr/rrLine" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/todayTime"
                        style="@style/Rr.Text.Hero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        style="@style/Rr.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/in_reels_today"
                        android:textColor="?attr/rrText2"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/moodText"
                style="@style/Rr.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:paddingTop="10dp"
                android:textColor="?attr/rrText2"
                android:textSize="13.5sp" />

            <LinearLayout
                android:id="@+id/appsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <TextView
                        style="@style/Rr.Text.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/top_apps_today" />

                    <TextView
                        android:id="@+id/allAppsLink"
                        style="@style/Rr.Text.Link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/all_apps" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/topApps"
                    android:clipToOutline="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/card_bg"
                    android:divider="@drawable/list_divider"
                    android:orientation="vertical"
                    android:showDividers="middle" />
            </LinearLayout>
        </LinearLayout>

        <!-- ───────────────────────── Progress ───────────────────────── -->
        <ScrollView
            android:id="@+id/pageProgress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="20dp">

                <TextView
                    style="@style/Rr.Text.ScreenTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:paddingBottom="12dp"
                    android:text="@string/tab_progress" />

                <com.reelcounter.SegmentedControl
                    android:id="@+id/progressSeg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:id="@+id/progressContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/rrLine" />

    <!-- Bottom bar: Home · Progress -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:background="?attr/rrNav"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/navHome"
            style="@style/Widget.Rr.NavItem"
            android:contentDescription="@string/tab_home">

            <FrameLayout
                android:id="@+id/navHomePill"
                android:layout_width="60dp"
                android:layout_height="28dp"
                android:background="@drawable/nav_pill">

                <ImageView
                    android:id="@+id/navHomeIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_home" />
            </FrameLayout>

            <TextView
                android:id="@+id/navHomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontVariationSettings="'wght' 600"
                android:importantForAccessibility="no"
                android:text="@string/tab_home"
                android:textColor="@color/nav_text"
                android:textSize="11.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProgress"
            style="@style/Widget.Rr.NavItem"
            android:contentDescription="@string/tab_progress">

            <FrameLayout
                android:id="@+id/navProgressPill"
                android:layout_width="60dp"
                android:layout_height="28dp"
                android:background="@drawable/nav_pill">

                <ImageView
                    android:id="@+id/navProgressIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_progress" />
            </FrameLayout>

            <TextView
                android:id="@+id/navProgressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontVariationSettings="'wght' 600"
                android:importantForAccessibility="no"
                android:text="@string/tab_progress"
                android:textColor="@color/nav_text"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
