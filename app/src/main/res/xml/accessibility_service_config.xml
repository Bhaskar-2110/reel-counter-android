<?xml version="1.0" encoding="utf-8"?>
<!-- No packageNames filter: the service needs window changes from every app to know when the
     user has left Reels/Shorts. Events from apps not in Platform.kt are dropped right away. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewScrolled|typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="false"
    android:description="@string/service_description"
    android:notificationTimeout="100" />
